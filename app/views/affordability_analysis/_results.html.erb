<%# locals: (analysis:, goal_type:, analysis_status:) %>

<div class="space-y-6">
  <%# Financial Health Assessment %>
  <div class="bg-white shadow-xs border border-alpha-black-25 rounded-xl p-6">
    <% if analysis_status.completed? %>
      <%# Financial Health %>
      <%= render "affordability_analysis/results/financial_health", analysis: analysis %>

      <%# Recommendation %>
      <%= render "affordability_analysis/results/recommendation", analysis: analysis %>

      <%# Improvement Steps %>
      <%= render "affordability_analysis/results/improvement_steps", analysis: analysis %>

      <%# Risks %>
      <%= render "affordability_analysis/results/risks", analysis: analysis %>
    <% else %>
      <div class="py-6">
        <div class="flex flex-col items-center justify-center gap-4">
          <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-primary"></div>
          <p class="text-sm text-secondary"><%= analysis_status.current_step %></p>
        </div>
      </div>
    <% end %>
  </div>
</div> 