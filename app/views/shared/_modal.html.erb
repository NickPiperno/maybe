<%# locals: (content:, classes:) -%>
<%= turbo_frame_tag "modal" do %>
  <%# Backdrop with improved opacity and blur %>
  <div class="fixed inset-0 bg-white/80 backdrop-blur-sm transition-opacity z-40"></div>
  
  <div class="fixed inset-0 z-50 overflow-y-auto">
    <div class="flex min-h-full items-center justify-center p-4 text-center sm:p-0">
      <div class="relative transform overflow-hidden rounded-2xl bg-white text-left shadow-xl transition-all sm:my-8 sm:w-full <%= classes %>">
        <%# Close button moved outside content area %>
        <div class="absolute right-4 top-4 z-10">
          <%= button_to scenarios_path, method: :get, class: "rounded-full p-2 text-secondary hover:bg-gray-25 hover:text-primary transition-colors", data: { turbo_frame: "_top" } do %>
            <%= lucide_icon "x", class: "h-5 w-5" %>
          <% end %>
        </div>
        
        <%# Content with subtle gradient background %>
        <div class="bg-gradient-to-b from-white to-gray-25/50">
          <%= content %>
        </div>
      </div>
    </div>
  </div>
<% end %>
